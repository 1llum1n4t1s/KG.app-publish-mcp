{
  "name": "@kagayoi/app-publish-mcp",
  "version": "1.0.10",
  "mcpName": "io.github.1llum1n4t1s/app-publish",
  "description": "Unified MCP server for App Store Connect & Google Play Console",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "app-publish-mcp": "dist/cli.js"
  },
  "scripts": {
    "build": "bun --no-env-file --no-install --bun run tsc",
    "dev": "bun --no-env-file --no-install src/index.ts",
    "start": "bun --no-env-file --no-install dist/index.js",
    "lint": "bun --no-env-file --no-install --bun run tsc --noEmit",
    "test": "bun --no-env-file --no-install test test/google-app-signing.test.ts test/audit-fixes.test.ts test/localization.test.ts test/compact.test.ts",
    "test:stdio": "bun --no-env-file --no-install --bun run build && bun --no-env-file --no-install test test/submission-stdio.test.mjs"
  },
  "keywords": [
    "mcp",
    "app-store-connect",
    "google-play",
    "apple",
    "android",
    "publish",
    "deploy",
    "mobile",
    "claude-code"
  ],
  "author": "1llum1n4t1s",
  "contributors": [
    "mikusnuz (original author of app-publish-mcp)"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1llum1n4t1s/KG.app-publish-mcp.git"
  },
  "homepage": "https://github.com/1llum1n4t1s/KG.app-publish-mcp#readme",
  "bugs": {
    "url": "https://github.com/1llum1n4t1s/KG.app-publish-mcp/issues"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "files": [
    "dist/**/*",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "google-auth-library": "^11.3.4",
    "googleapis": "^190.0.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
